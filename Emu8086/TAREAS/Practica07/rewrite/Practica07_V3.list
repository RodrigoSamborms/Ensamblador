[  24]        :                                       
[  25]        :                                       ;definir funciones y procedimientos
[  26]        :                                       ; Funcion: PRINT_NUM_CARA
[  27]        :                                       ; Entrada: AX = Valor numérico a imprimir (ej. cont_caracteres)
[  28]        :                                       ; Salida: Imprime el numero en consola con formato estricto de 3 digitos (000)
[  29]        :                                       ; funcionamiento:
[  30]        :                                       ; el numero esta almacenado en binario, asi que vamos a extraer
[  31]        :                                       ; los digitos equivalentes a las centenas, decenas y unidades
[  32]        :                                       ; mediante divisiones sucesivas entre 10
[  33]        :                                       ; el caracter binario obtenido como cociente se le suma 30h
[  34]        :                                       ; para generar el caracter ASCII correspondiente
[  35]        :                                       ; el valor del residuo es lo siguiente a dividir para
[  36]        :                                       ; obtener el siguiente digito
[  37]    01E9:                                       PRINT_NUM_CARA PROC
[  38]    01E9: 50                                    PUSH AX   ;Guardamos los registros en la pila para no
[  39]    01EA: 53                                    PUSH BX   ;alterar los valores del programa principal
[  40]    01EB: 51                                    PUSH CX   ;esta es una practica comun arquitecturas
[  41]    01EC: 52                                    PUSH DX   ;posteriores tienen instrucciones que facilitan ester proceso
[  42]        :                                       
[  43]    01ED: 8B D8                                 MOV BX, AX;Pasamos el numero a BX para trabajar cómodamente
[  44]        :                                       
[  45]        :                                       ;Centenas
[  46]    01EF: 8B C3                                 MOV AX, BX  ;Colocamos el numero completo en AX
[  47]    01F1: BA 00 00                              MOV DX, 0   ;Limpiamos DX para la division de 16 bits
[  48]    01F4: B9 64 00                              MOV CX, 100 ;Divisor = 100
[  49]    01F7: F7 F1                                 DIV CX      ;AX = Cociente (Centenas), DX = Residuo
[  50]        :                                       
[  51]    01F9: 8B DA                                 MOV BX, DX  ;Guardamos provisionalmente el residuo en BX para despues
[  52]        :                                       
[  53]        :                                       ;Imprimir las Centenas
[  54]    01FB: 8A D0                                 MOV DL, AL   ;Movemos el cociente a DL
[  55]    01FD: 80 C2 30                              ADD DL, 30h  ;Convertimos el número a su carácter ASCII (ej: 0 -> '0')
[  56]    0200: B4 02                                 MOV AH, 02h  ;Funcion 02h de la INT 21h para imprimir caracter
[  57]    0202: CD 21                                 INT 21h
[  58]        :                                       
[  59]        :                                       ;Decenas y unidades
[  60]        :                                       ;la ultima division nos entrega las decenas en el cociente
[  61]        :                                       ;y las unidades en el residuo
[  62]    0204: 8B C3                                 MOV AX, BX ;Recuperamos el residuo anterior (lo que quedó de las centenas)
[  63]    0206: BA 00 00                              MOV DX, 0  ;Limpiamos DX
[  64]    0209: B9 0A 00                              MOV CX, 10 ;Divisor = 10
[  65]    020C: F7 F1                                 DIV CX     ;AX = Cociente (Decenas), DX = Residuo (Unidades)
[  66]        :                                       
[  67]    020E: 8B DA                                 MOV BX, DX ;Guardamos el residuo final (unidades) en BX
[  68]        :                                       
[  69]        :                                       ;Imprimir las Decenas
[  70]    0210: 8A D0                                 MOV DL, AL  ;Movemos las decenas a DL
[  71]    0212: 80 C2 30                              ADD DL, 30h ;Convertimos a ASCII
[  72]    0215: B4 02                                 MOV AH, 02h
[  73]    0217: CD 21                                 INT 21h
[  74]        :                                       
[  75]        :                                       ; Imprimir las Unidades
[  76]    0219: 8A D3                                 MOV DL, BL  ;Recuperamos el residuo final (unidades) de BX
[  77]    021B: 80 C2 30                              ADD DL, 30h ;Convertimos a ASCII
[  78]    021E: B4 02                                 MOV AH, 02h
[  79]    0220: CD 21                                 INT 21h
[  80]        :                                       
[  81]    0222: 5A                                    POP DX   ;Restauramos los registros de la pila en orden inverso
[  82]    0223: 59                                    POP CX   ;Lo cual es una practica comun
[  83]    0224: 5B                                    POP BX   ;arquitecturas posteriores tienen instrucciones
[  84]    0225: 58                                    POP AX   ;que facilitan este proceso
[  85]    0226: C3                                    RET                 ; Regresamos al flujo principal del programa
[  86]        :                                       PRINT_NUM_CARA ENDP
